{
  "family": "ith5",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::AWS_ACCOUNT_ID:role/ith5TaskRole",
  "volumes": [
    {
      "name": "pgdata",
      "host": {
        "sourcePath": "/opt/ith5/postgres"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "postgres",
      "image": "postgres:17-alpine",
      "essential": true,
      "environment": [
        { "name": "POSTGRES_USER", "value": "ith5" },
        { "name": "POSTGRES_DB", "value": "ith5" }
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "POSTGRES_PASSWORD_SECRET_ARN"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "pgdata",
          "containerPath": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U ith5 -d ith5"],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ith5",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "postgres"
        }
      }
    },
    {
      "name": "ith5-server",
      "image": "AWS_ACCOUNT_ID.dkr.ecr.AWS_REGION.amazonaws.com/ith5:IMAGE_TAG",
      "essential": true,
      "links": ["postgres"],
      "dependsOn": [
        {
          "containerName": "postgres",
          "condition": "HEALTHY"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ITH5_LISTEN_ADDR",
          "value": ":8080"
        },
        {
          "name": "ITH5_BASE_URL",
          "value": "https://YOUR_DOMAIN"
        },
        {
          "name": "ITH5_DIST_DIR",
          "value": "/opt/ith5/dist"
        }
      ],
      "secrets": [
        {
          "name": "ITH5_DATABASE_URL",
          "valueFrom": "DATABASE_URL_SECRET_ARN"
        },
        {
          "name": "ITH5_JWT_SECRET",
          "valueFrom": "JWT_SECRET_ARN"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://localhost:8080/healthz || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ith5",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "server"
        }
      }
    }
  ]
}
